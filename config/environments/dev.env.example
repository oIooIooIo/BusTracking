# APPROVED ENVIRONMENT TEMPLATE: DEV
# Deployed from offline Docker images.
APP_ENV=dev

# Public/application URLs
PUBLIC_WEB_URL=https://taxiportal-dev.fushan.fihnbb.com
VITE_API_URL=/api/admin/v1
MOBILE_API_BASE_URL=https://taxiportal-dev.fushan.fihnbb.com/api/device/v1/
MOBILE_USES_CLEARTEXT=false
ADMIN_WEB_ORIGIN=https://taxiportal-dev.fushan.fihnbb.com
SERVER_PORT=8080

# PostgreSQL inside the DEV Docker network
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=bus_tracking
POSTGRES_USER=bus_tracking
POSTGRES_PASSWORD=CHANGE_ME_DEV_DATABASE_PASSWORD
DB_URL=jdbc:postgresql://postgres:5432/bus_tracking
DB_USERNAME=bus_tracking
DB_PASSWORD=CHANGE_ME_DEV_DATABASE_PASSWORD

# Redis inside the DEV Docker network
REDIS_HOST=redis
REDIS_PORT=6379

# DEV credentials: populate only in the untracked deployment .env file
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_DEV_ADMIN_PASSWORD
DEVICE_API_KEY=CHANGE_ME_DEV_DEVICE_API_KEY

# Offline image deployment
BACKEND_IMAGE=bus-tracking-backend:0.1.0
ADMIN_WEB_IMAGE=bus-tracking-admin-web:0.1.0
POSTGRES_IMAGE=postgis/postgis:16-3.4
REDIS_IMAGE=redis:7-alpine
TLS_CERT_DIR=/opt/bus-tracking/secrets/tls
OFFLINE_PACKAGE_NAME=bus-tracking-images-0.1.0.tar
