# APPROVED ENVIRONMENT TEMPLATE: LOCAL
# Runs directly on the developer computer. Docker is not used.
APP_ENV=local

# Public/application URLs
PUBLIC_WEB_URL=http://localhost:5173
VITE_API_URL=http://localhost:8080/api/admin/v1
# Physical Android devices reach the native LOCAL backend through USB ADB reverse.
# Before testing or synchronization, run: adb reverse tcp:8080 tcp:8080
MOBILE_API_BASE_URL=http://127.0.0.1:8080/api/device/v1/
MOBILE_USES_CLEARTEXT=true
ADMIN_WEB_ORIGIN=http://localhost:5173
SERVER_PORT=8080

# PostgreSQL installed and started directly on the computer
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=bus_tracking
POSTGRES_USER=bus_tracking
POSTGRES_PASSWORD=bus_tracking
DB_URL=jdbc:postgresql://localhost:5432/bus_tracking
DB_USERNAME=bus_tracking
DB_PASSWORD=bus_tracking

# Redis installed and started directly on the computer
REDIS_HOST=localhost
REDIS_PORT=6379

# Local-only demo credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
DEVICE_API_KEY=demo-device-key

# Not used in LOCAL
BACKEND_IMAGE=
ADMIN_WEB_IMAGE=
POSTGRES_IMAGE=
REDIS_IMAGE=
TLS_CERT_DIR=
OFFLINE_PACKAGE_NAME=
